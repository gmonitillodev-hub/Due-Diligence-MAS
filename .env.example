# LLM Config
GROQ_API_KEY=gsk_***
OPENAI_API_KEY=sk-*****
DEFAULT_REASONING_LEVEL=high
DEFAULT_LLM_PROVIDER=openai

# Tools config
TAVILY_API_KEY=tvly-***
APIFY_API_TOKEN=apify_api_***

# Verbose confing
AGENT_VERBOSE=false
CREW_VERBOSE=true
FLOW_VERBOSE=true

# Tracing config
CREWAI_TRACING_ENABLED=true

# LangSmith tracing (LangGraph)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-langsmith-tracing-key>
LANGSMITH_PROJECT=due_diligence
